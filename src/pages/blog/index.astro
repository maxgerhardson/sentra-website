---
import ComingSoon from '../../layouts/ComingSoon.astro';

const posts = [
  {
    slug: "regulation-into-code",
    title: "Turning Regulation into Code: What a16z Got Right (and What They Missed)",
    subtitle: "The compliance industry's biggest unlock isn't hiring more people or buying more GRC software. It's making regulatory rules executable.",
    date: "May 27, 2026",
    reading: "7 min read",
    tags: ["Compliance", "AI Governance", "Engineering"],
  },
  {
    slug: "prove-compliance-ai-generated-code",
    title: "How to Prove Compliance in AI-Generated Code",
    subtitle: "Every security tool tells you what's wrong. None prove what's right. Here's how compliance evidence maps change the audit conversation.",
    date: "April 10, 2026",
    reading: "8 min read",
    tags: ["Compliance", "Audit", "AI Code"],
  },
  {
    slug: "why-ai-code-needs-governance",
    title: "Why AI-Generated Code Needs Governance",
    subtitle: "AI coding agents ship code faster than any team can review it. Here's why that's a compliance problem — and what to do about it.",
    date: "March 5, 2026",
    reading: "6 min read",
    tags: ["AI Governance", "Compliance"],
  },
  {
    slug: "iec-62304-in-cicd",
    title: "How sentrik Enforces IEC 62304 in CI/CD",
    subtitle: "A practical guide to automating IEC 62304 compliance for medical device software in your CI/CD pipeline.",
    date: "March 5, 2026",
    reading: "7 min read",
    tags: ["Medical Devices", "IEC 62304", "CI/CD"],
  },
  {
    slug: "getting-started-in-5-minutes",
    title: "Getting Started with sentrik in 5 Minutes",
    subtitle: "Install sentrik, scan your code, and enforce a quality gate — all in under 5 minutes. Zero config required.",
    date: "March 5, 2026",
    reading: "5 min read",
    tags: ["Tutorial", "Getting Started"],
  },
];
---

<ComingSoon title="Blog" description="Practical writing on AI governance, compliance engineering, and building software that can prove it's doing the right thing.">

<section class="blog-index">
  <div class="container blog-index-container">
    <header class="blog-index-header">
      <h1>Blog</h1>
      <p>Practical writing on AI governance, compliance engineering, and building software that can prove it&rsquo;s doing the right thing.</p>
    </header>

    <div class="post-list">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="post-card">
          <div class="post-meta">
            <span class="post-date">{post.date}</span>
            <span class="post-sep">&middot;</span>
            <span class="post-reading">{post.reading}</span>
          </div>
          <h2 class="post-title">{post.title}</h2>
          <p class="post-subtitle">{post.subtitle}</p>
          <div class="post-tags">
            {post.tags.map(tag => <span class="post-tag">{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .blog-index { padding: 5rem 0 8rem; }
  .blog-index-container { max-width: 760px; }
  .blog-index-header { margin-bottom: 3rem; border-bottom: 1px solid var(--color-border); padding-bottom: 2rem; }
  .blog-index-header h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 0.75rem; }
  .blog-index-header p { color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.6; }

  .post-list { display: flex; flex-direction: column; gap: 2rem; }
  .post-card {
    display: block;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    background: var(--color-bg-alt);
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .post-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(99,102,241,0.12);
    text-decoration: none;
  }
  .post-meta { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 0.75rem; }
  .post-sep { opacity: 0.4; }
  .post-title { font-size: 1.3rem; font-weight: 700; line-height: 1.35; margin-bottom: 0.6rem; color: var(--color-text); }
  .post-subtitle { color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1rem; }
  .post-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .post-tag { font-size: 0.75rem; font-weight: 500; padding: 0.2rem 0.6rem; border-radius: 20px; background: rgba(99,102,241,0.12); color: var(--color-primary-light); }
</style>

</ComingSoon>
