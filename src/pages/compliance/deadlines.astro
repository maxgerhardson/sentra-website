---
import ComingSoon from '../../layouts/ComingSoon.astro';

const milestones = [
  { date: '2026-08-02', framework: 'EU AI Act', title: 'Article 50 transparency + enforcement powers', desc: 'Chatbot transparency duties apply and national authorities gain enforcement powers — penalties up to 3% of global revenue for high-risk non-compliance.', pack: 'eu-ai-act' },
  { date: '2026-09-11', framework: 'EU Cyber Resilience Act', title: 'Vulnerability reporting obligations', desc: 'Manufacturers must report actively exploited vulnerabilities and severe incidents to ENISA within 24 hours.', pack: 'supply-chain-security' },
  { date: '2026-11-10', framework: 'CMMC 2.0', title: 'Phase 2 — third-party certification', desc: 'Level 2 C3PAO certification requirements begin appearing in applicable DoD solicitations.', pack: 'cmmc' },
  { date: '2026-12-02', framework: 'EU AI Act', title: 'AI-generated content labeling', desc: 'Marking obligations for AI-generated and manipulated content apply (deferred four months by the Digital Omnibus).', pack: 'eu-ai-act' },
  { date: '2027-12-02', framework: 'EU AI Act', title: 'Annex III high-risk obligations', desc: 'Stand-alone high-risk AI systems must comply: risk management, data governance, human oversight, logging, documentation.', pack: 'eu-ai-act' },
  { date: '2027-12-11', framework: 'EU Cyber Resilience Act', title: 'Full CRA obligations', desc: 'All essential cybersecurity requirements apply to products with digital elements sold in the EU — secure development, vulnerability handling, SBOM, support periods.', pack: 'supply-chain-security' },
  { date: '2028-08-02', framework: 'EU AI Act', title: 'Annex I embedded high-risk AI', desc: 'AI embedded in regulated products — medical devices, machinery, vehicles — must meet high-risk obligations.', pack: 'eu-ai-act' },
];

const inForce = [
  { date: '2025-11-10', framework: 'CMMC 2.0', title: 'Phase 1 self-assessments in DoD contracts' },
  { date: '2025-10-31', framework: 'ISO 27001', title: '2022 transition complete — 2013 certificates expired' },
  { date: '2025-08-02', framework: 'EU AI Act', title: 'GPAI model obligations and governance rules' },
  { date: '2025-03-31', framework: 'PCI DSS', title: 'v4.x future-dated requirements mandatory' },
  { date: '2023-10-01', framework: 'FDA §524B', title: 'Cyber device premarket cybersecurity requirements' },
];
---

<ComingSoon title="Regulatory Deadline Calendar" description="Every enforcement date that matters for software teams: EU AI Act (post-omnibus), Cyber Resilience Act, CMMC 2.0, PCI DSS, ISO 27001, FDA. Live countdowns, mapped to Sentrik standards packs.">

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-badge">Updated July 2026 &mdash; post-omnibus dates</div>
    <h1>The regulatory deadlines<br /><span class="gradient-text">software teams actually face</span></h1>
    <p class="hero-sub">
      The EU AI Act's high-risk deadlines moved to 2027 and 2028 &mdash; but transparency obligations still land this August, the Cyber Resilience Act's reporting duties start in September, and CMMC certification begins in November. Compliance programs take 12&ndash;18 months. The deadline moved; the work didn't.
    </p>
    <div class="hero-actions">
      <code class="hero-cmd">sentrik deadlines</code>
    </div>
    <p class="hero-free">The same calendar, scoped to your enabled packs, in your terminal and dashboard.</p>
  </div>
</section>

<section class="countdown">
  <div class="container">
    <h2 class="section-title">Coming into force</h2>
    <p class="section-sub">Countdowns are live &mdash; they update every time you load this page.</p>
    <div class="timeline">
      {milestones.map((m) => (
        <div class="timeline-card">
          <div class="timeline-when">
            <span class="timeline-date">{m.date}</span>
            <span class="timeline-days" data-date={m.date}></span>
          </div>
          <div class="timeline-body">
            <span class="timeline-framework">{m.framework}</span>
            <h3>{m.title}</h3>
            <p>{m.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="inforce">
  <div class="container">
    <h2 class="section-title">Already in force</h2>
    <p class="section-sub">If these apply to you, the audit question is no longer &ldquo;are you ready?&rdquo; &mdash; it's &ldquo;show me the evidence.&rdquo;</p>
    <div class="inforce-list">
      {inForce.map((m) => (
        <div class="inforce-row">
          <span class="inforce-date">{m.date}</span>
          <span class="inforce-framework">{m.framework}</span>
          <span class="inforce-title">{m.title}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="cta">
  <div class="container">
    <h2>Turn deadlines into evidence</h2>
    <p class="cta-sub">Sentrik ships rule packs for every framework above &mdash; scan your code, see the gaps clause by clause, and generate the evidence auditors ask for.</p>
    <div class="cta-cmd"><code>pip install sentrik &amp;&amp; sentrik deadlines &amp;&amp; sentrik scan</code></div>
    <p class="hero-free">Free tier: 6 packs, 193 rules, forever.</p>
  </div>
</section>

<script>
  document.querySelectorAll('.timeline-days').forEach((el) => {
    const target = new Date(el.getAttribute('data-date') + 'T00:00:00');
    const days = Math.ceil((target.getTime() - Date.now()) / 86400000);
    if (days < 0) { el.textContent = 'in force'; el.classList.add('past'); }
    else { el.textContent = `in ${days} days`; if (days <= 90) el.classList.add('soon'); }
  });
</script>

</ComingSoon>

<style>
  .hero { padding: 10rem 0 5rem; text-align: center; }
  .hero-badge { display: inline-block; padding: 0.4rem 1.2rem; border-radius: 20px; background: linear-gradient(135deg, #f59e0b, #ef4444); color: #fff; font-size: 0.85rem; font-weight: 600; margin-bottom: 1.5rem; letter-spacing: 0.05em; text-transform: uppercase; }
  .hero h1 { margin-bottom: 1.5rem; font-size: 3rem; line-height: 1.15; }
  .gradient-text { background: linear-gradient(135deg, #f59e0b, #ef4444); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .hero-sub { font-size: 1.15rem; color: var(--color-text-muted); max-width: 720px; margin: 0 auto 2rem; line-height: 1.7; }
  .hero-cmd { display: inline-block; padding: 0.7rem 1.5rem; background: rgba(6, 182, 212, 0.1); border: 1px solid rgba(6, 182, 212, 0.3); color: var(--color-accent); border-radius: 8px; font-size: 1rem; }
  .hero-free { color: var(--color-text-muted); font-size: 0.9rem; margin-top: 1rem; }
  .section-title { text-align: center; font-size: 2rem; margin-bottom: 0.75rem; }
  .section-sub { text-align: center; color: var(--color-text-muted); font-size: 1rem; margin-bottom: 3rem; max-width: 640px; margin-left: auto; margin-right: auto; }
  .countdown { padding: 5rem 0; background: var(--color-bg-alt); }
  .timeline { max-width: 860px; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem; }
  .timeline-card { display: grid; grid-template-columns: 160px 1fr; gap: 1.5rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; padding: 1.5rem 1.75rem; }
  .timeline-when { display: flex; flex-direction: column; gap: 0.35rem; }
  .timeline-date { font-weight: 800; font-size: 1.05rem; }
  .timeline-days { font-size: 0.9rem; color: var(--color-text-muted); }
  .timeline-days.soon { color: #ef4444; font-weight: 700; }
  .timeline-days.past { color: var(--color-text-muted); }
  .timeline-framework { display: inline-block; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 0.35rem; }
  .timeline-body h3 { font-size: 1.1rem; margin-bottom: 0.4rem; }
  .timeline-body p { color: var(--color-text-muted); font-size: 0.92rem; line-height: 1.6; }
  .inforce { padding: 5rem 0; }
  .inforce-list { max-width: 760px; margin: 0 auto; }
  .inforce-row { display: grid; grid-template-columns: 110px 150px 1fr; gap: 1rem; padding: 0.8rem 1rem; border-bottom: 1px solid var(--color-border); font-size: 0.92rem; }
  .inforce-date { color: var(--color-text-muted); }
  .inforce-framework { font-weight: 700; color: var(--color-accent); }
  .inforce-title { color: var(--color-text-muted); }
  .cta { padding: 5rem 0; text-align: center; background: var(--color-bg-alt); }
  .cta h2 { font-size: 2rem; margin-bottom: 0.75rem; }
  .cta-sub { color: var(--color-text-muted); font-size: 1.05rem; margin-bottom: 1.5rem; max-width: 620px; margin-left: auto; margin-right: auto; }
  .cta-cmd code { display: inline-block; padding: 0.7rem 1.5rem; background: rgba(6, 182, 212, 0.1); border: 1px solid rgba(6, 182, 212, 0.3); color: var(--color-accent); border-radius: 8px; font-size: 0.95rem; }
  @media (max-width: 700px) {
    .hero h1 { font-size: 2.1rem; }
    .timeline-card { grid-template-columns: 1fr; gap: 0.5rem; }
    .inforce-row { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
