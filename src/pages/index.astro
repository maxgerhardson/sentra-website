</style>

<script>
  // ── Lightbox ──────────────────────────────────────────────────────────────
  function openLightbox(src, alt) {
    var lb = document.getElementById('lightbox');
    var img = document.getElementById('lightbox-img');
    img.src = src; img.alt = alt;
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    document.getElementById('lightbox').classList.remove('open');
    document.body.style.overflow = '';
  }
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('expandable')) {
      e.preventDefault();
      openLightbox(e.target.src, e.target.alt);
    }
  });

  // ── Risk Calculator Modal ─────────────────────────────────────────────────
  var riskData = { email:'', teamSize:null, aiPct:null, aiTools:[], frameworks:[], revenue:null, hasSecTeam:null, jobTitle:'', company:'' };

  function openRiskModal(email) {
    riskData.email = email;
    var modal = document.getElementById('risk-modal');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    // animate ring in on next tick (so transition fires)
    setTimeout(function() {
      document.getElementById('risk-ring-arc').style.strokeDashoffset = '289';
    }, 50);
  }
  function closeRiskModal() {
    document.getElementById('risk-modal').style.display = 'none';
    document.body.style.overflow = '';
  }
  function handleRiskOverlayClick(e) {
    if (e.target === document.getElementById('risk-modal')) closeRiskModal();
  }

  function setStepIndicator(step) {
    document.querySelectorAll('.risk-step-dot').forEach(function(dot) {
      var s = parseInt(dot.dataset.step);
      dot.classList.remove('active', 'done');
      if (s === step) dot.classList.add('active');
      else if (s < step) dot.classList.add('done', 'active');
    });
  }

  function getSelected(groupId) {
    var group = document.getElementById(groupId);
    if (!group) return null;
    if (group.classList.contains('multi')) {
      return Array.from(group.querySelectorAll('.risk-opt.selected')).map(function(b) { return b.dataset.value; });
    }
    var sel = group.querySelector('.risk-opt.selected');
    return sel ? sel.dataset.value : null;
  }

  function riskNext(toStep) {
    if (toStep === 2) {
      var ts = getSelected('team-size-opts');
      var ap = getSelected('ai-pct-opts');
      var errEl = document.getElementById('step1-error');
      if (!ts || !ap) { errEl.style.display = 'block'; return; }
      errEl.style.display = 'none';
      riskData.teamSize = ts;
      riskData.aiPct = ap;
      riskData.aiTools = getSelected('ai-tools-opts') || [];
    } else if (toStep === 3) {
      riskData.frameworks = getSelected('frameworks-opts') || [];
      riskData.revenue = getSelected('revenue-opts');
      riskData.hasSecTeam = getSelected('sec-team-opts');
    }
    document.getElementById('risk-step-' + (toStep - 1)).style.display = 'none';
    document.getElementById('risk-step-' + toStep).style.display = 'block';
    setStepIndicator(toStep);
    document.querySelector('.risk-modal').scrollTop = 0;
  }

  function riskBack(toStep) {
    document.getElementById('risk-step-' + (toStep + 1)).style.display = 'none';
    document.getElementById('risk-step-' + toStep).style.display = 'block';
    setStepIndicator(toStep);
    document.querySelector('.risk-modal').scrollTop = 0;
  }

  function calculateRisk() {
    riskData.jobTitle = document.getElementById('modal-job-title').value || '';
    riskData.company  = document.getElementById('modal-company').value || '';

    var teamSize  = parseFloat(riskData.teamSize) || 5;
    var aiPct     = parseFloat(riskData.aiPct) || 10;
    var revenue   = parseFloat(riskData.revenue) || 1000000;
    var frameworks = riskData.frameworks || [];
    var hasSecTeam = riskData.hasSecTeam === 'yes';

    // Secrets exposed per year
    var secrets = Math.max(1, Math.round(teamSize * (aiPct / 100) * 0.023 * 3 * 52));

    // Audit hours
    var baseHours = 120;
    var teamMult = teamSize <= 5 ? 0.8 : teamSize <= 15 ? 1.0 : teamSize <= 50 ? 1.4 : 1.8;
    var aiMult   = aiPct < 20 ? 1.1 : aiPct < 50 ? 1.3 : aiPct < 80 ? 1.6 : 2.0;
    var secMult  = hasSecTeam ? 0.7 : 1.3;
    var auditHours = Math.round(baseHours * teamMult * aiMult * secMult);

    // Regulatory fines
    var hipaaViolations = Math.max(1, Math.round(secrets * 0.15));
    var hipaaFine = Math.min(hipaaViolations * 12000, 1900000);
    var euFine    = Math.round(revenue * 0.015);

    // Risk score 0–100 (higher = worse)
    var score = 30;
    score += Math.min(35, Math.round(secrets * 1.5));
    score += aiPct >= 80 ? 18 : aiPct >= 50 ? 12 : aiPct >= 20 ? 6 : 2;
    score += hasSecTeam ? -10 : 8;
    score += frameworks.length >= 3 ? 8 : frameworks.length >= 1 && frameworks[0] !== 'none' ? 4 : 0;
    score = Math.min(99, Math.max(8, Math.round(score)));

    var grade = score >= 80 ? 'F' : score >= 65 ? 'D' : score >= 50 ? 'C' : score >= 35 ? 'B' : 'A';
    var gradeColor = score >= 80 ? '#ef4444' : score >= 65 ? '#f97316' : score >= 50 ? '#eab308' : score >= 35 ? '#22c55e' : '#06b6d4';
    var headline = score >= 80 ? 'Critical exposure — immediate action needed' :
                   score >= 65 ? 'High risk — significant compliance gaps' :
                   score >= 50 ? 'Moderate risk — several gaps to address' :
                   score >= 35 ? 'Low risk — a few areas to tighten' :
                                 'Minimal risk — well-controlled environment';

    // Update UI
    document.getElementById('risk-grade-letter').textContent = grade;
    document.getElementById('risk-score-num').textContent = score;
    document.getElementById('risk-headline').textContent = headline;
    var arc = document.getElementById('risk-ring-arc');
    arc.style.stroke = gradeColor;
    arc.style.strokeDashoffset = Math.round(289 * (1 - score / 100));

    document.getElementById('metric-secrets').textContent = secrets.toLocaleString();
    document.getElementById('metric-audit').textContent   = auditHours + ' hrs';

    var hasHipaa = frameworks.indexOf('hipaa') > -1;
    var hasEuai  = frameworks.indexOf('euai') > -1;
    document.getElementById('hipaa-row').style.display = hasHipaa ? 'block' : 'none';
    document.getElementById('euai-row').style.display  = hasEuai  ? 'block' : 'none';
    if (hasHipaa) document.getElementById('metric-hipaa').textContent = '$' + hipaaFine.toLocaleString();
    if (hasEuai)  document.getElementById('metric-euai').textContent  = '$' + euFine.toLocaleString();

    // Show results pane
    document.getElementById('risk-step-3').style.display = 'none';
    document.getElementById('risk-results').style.display = 'block';
    document.querySelector('.risk-modal').scrollTop = 0;

    // Submit risk data (fire-and-forget)
    fetch('https://formsubmit.co/ajax/max@sentrik.dev', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        _subject: 'Risk Calculator Completed — sentrik.dev',
        _captcha: 'false',
        email:             riskData.email,
        job_title:         riskData.jobTitle,
        company:           riskData.company,
        team_size:         riskData.teamSize || '',
        ai_pct:            riskData.aiPct || '',
        ai_tools:          (riskData.aiTools || []).join(', '),
        frameworks:        (riskData.frameworks || []).join(', '),
        revenue_range:     riskData.revenue || '',
        has_security_team: riskData.hasSecTeam || '',
        risk_score:        score,
        secrets_per_year:  secrets,
        audit_hours:       auditHours,
        hipaa_exposure:    hasHipaa ? hipaaFine : '',
        eu_ai_exposure:    hasEuai  ? euFine    : ''
      })
    }).catch(function() {});
  }

  // ── Early Access Form ──────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', function() {
    // Wire up single-select option buttons
    document.querySelectorAll('.risk-options:not(.multi)').forEach(function(group) {
      group.querySelectorAll('.risk-opt').forEach(function(btn) {
        btn.addEventListener('click', function() {
          group.querySelectorAll('.risk-opt').forEach(function(b) { b.classList.remove('selected'); });
          btn.classList.add('selected');
        });
      });
    });
    // Wire up multi-select option buttons
    document.querySelectorAll('.risk-options.multi').forEach(function(group) {
      group.querySelectorAll('.risk-opt').forEach(function(btn) {
        btn.addEventListener('click', function() { btn.classList.toggle('selected'); });
      });
    });

    // Intercept "Get Free Access" form
    var form = document.getElementById('early-access-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var email     = document.getElementById('ea-email').value.trim();
        var submitBtn = document.getElementById('ea-submit');
        var errorDiv  = document.getElementById('ea-error');

        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
        errorDiv.style.display = 'none';

        var fd = new FormData();
        fd.append('form-name', 'early-access');
        fd.append('email', email);

        fetch('https://formsubmit.co/ajax/max@sentrik.dev', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ email: email, _subject: 'New Early Access Request — sentrik.dev', _captcha: 'false' })
        })
          .finally(function() {
            // Always open the modal regardless of network result
            document.getElementById('free-thanks').style.display = 'block';
            form.style.display = 'none';
            openRiskModal(email);
          });
      });
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { closeLightbox(); closeRiskModal(); }
  });

  // Expose to global scope so inline onclick attributes can reach them
  window.openLightbox = openLightbox;
  window.closeLightbox = closeLightbox;
  window.openRiskModal = openRiskModal;
  window.closeRiskModal = closeRiskModal;
  window.handleRiskOverlayClick = handleRiskOverlayClick;
  window.riskNext = riskNext;
  window.riskBack = riskBack;
  window.calculateRisk = calculateRisk;
</script>
